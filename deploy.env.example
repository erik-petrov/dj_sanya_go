# Copy to `deploy.env` (gitignored) and fill in. Used by scripts/sync-secrets.sh
# to push gitignored secret/config files to your server on every `git push`.
#
# DEPLOY_HOST: where to sync to. Can be `user@host`, but the cleanest option is
# an alias from your ~/.ssh/config so the port / key / user live there and this
# file stays simple:
#
#   Host mybot
#       HostName 203.0.113.10
#       User erik
#       IdentityFile ~/.ssh/id_ed25519
#
# then set DEPLOY_HOST=mybot below.
DEPLOY_HOST=user@your.server.example

# Absolute path to the checked-out repo on the server (where `docker compose` runs).
DEPLOY_PATH=/home/user/dj_sanya_go
